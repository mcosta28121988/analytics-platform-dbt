# Copy this file to `.env` (gitignored) and fill in real values.
# Never put real secrets in this example file.

# --- Kaggle (Phase 0: dataset download) ---------------------------------
# Create at https://www.kaggle.com/settings -> API -> "Generate New Token"
KAGGLE_API_TOKEN=

# --- Snowflake (Phase 1+) -----------------------------------------------
# Account identifier in <orgname>-<accountname> form
#   (Snowsight: bottom-left account menu > View account details > Account identifier)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=OLIST_SVC_DEV
SNOWFLAKE_ROLE=OLIST_TRANSFORMER_DEV
SNOWFLAKE_WAREHOUSE=OLIST_TRANSFORMING_WH
# Private key lives OUTSIDE the repo
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/olist_svc_dev.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
